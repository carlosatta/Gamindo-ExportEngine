{
  "info": {
    "name": "Export Engine API",
    "description": "API REST per ingestione dati statistici di versione ed export XLSX asincroni. Base path /api/v1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "version_id", "value": "1" },
    { "key": "export_id", "value": "1" }
  ],
  "item": [
    {
      "name": "Versions",
      "item": [
        {
          "name": "List versions",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/versions", "host": ["{{base_url}}"], "path": ["versions"] }
          }
        },
        {
          "name": "Create version",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Summer Campaign 2026\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/versions", "host": ["{{base_url}}"], "path": ["versions"] }
          }
        },
        {
          "name": "Show version",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/versions/{{version_id}}", "host": ["{{base_url}}"], "path": ["versions", "{{version_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Ingestion",
      "description": "Ogni endpoint accetta un oggetto singolo o un array. Risposta sempre HTTP 200 con status success o partial_success.",
      "item": [
        {
          "name": "Ingest players",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"external_player_id\": \"ext-123\",\n    \"email\": \"player@example.com\",\n    \"language\": \"it\",\n    \"utm_source\": \"google\",\n    \"company\": \"Acme\",\n    \"marketing_optin\": true,\n    \"registered_at\": \"2026-01-15T10:00:00Z\",\n    \"status\": \"active\"\n  }\n]",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/versions/{{version_id}}/players", "host": ["{{base_url}}"], "path": ["versions", "{{version_id}}", "players"] }
          }
        },
        {
          "name": "Ingest events",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"external_player_id\": \"ext-123\",\n    \"type\": \"completed\",\n    \"occurred_at\": \"2026-01-15T10:05:00Z\",\n    \"payload\": {\n      \"score\": 100,\n      \"level\": 3,\n      \"language\": \"it\"\n    }\n  }\n]",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/versions/{{version_id}}/events", "host": ["{{base_url}}"], "path": ["versions", "{{version_id}}", "events"] }
          }
        },
        {
          "name": "Ingest transactions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"external_player_id\": \"ext-123\",\n    \"transaction_id\": \"txn-1\",\n    \"type\": \"purchase\",\n    \"amount\": 9.99,\n    \"currency\": \"EUR\",\n    \"occurred_at\": \"2026-01-15T10:10:00Z\"\n  }\n]",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/versions/{{version_id}}/transactions", "host": ["{{base_url}}"], "path": ["versions", "{{version_id}}", "transactions"] }
          }
        },
        {
          "name": "Ingest answers",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"external_player_id\": \"ext-123\",\n    \"question_id\": \"q1\",\n    \"question\": \"Favorite color?\",\n    \"answer\": \"blue\",\n    \"occurred_at\": \"2026-01-15T10:07:00Z\"\n  }\n]",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/versions/{{version_id}}/answers", "host": ["{{base_url}}"], "path": ["versions", "{{version_id}}", "answers"] }
          }
        },
        {
          "name": "Ingest rewards",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"external_player_id\": \"ext-123\",\n    \"reward_type\": \"coupon_10\",\n    \"reward_code\": \"SAVE10\",\n    \"assigned_at\": \"2026-01-15T10:12:00Z\"\n  }\n]",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/versions/{{version_id}}/rewards", "host": ["{{base_url}}"], "path": ["versions", "{{version_id}}", "rewards"] }
          }
        }
      ]
    },
    {
      "name": "Exports",
      "item": [
        {
          "name": "List all exports",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/exports", "host": ["{{base_url}}"], "path": ["exports"] }
          }
        },
        {
          "name": "List exports (version)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/versions/{{version_id}}/exports", "host": ["{{base_url}}"], "path": ["versions", "{{version_id}}", "exports"] }
          }
        },
        {
          "name": "Create export",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"format\": \"xlsx\",\n  \"date_from\": \"2026-01-01\",\n  \"date_to\": \"2026-01-31\",\n  \"sheets\": [\n    { \"name\": \"readme\" },\n    { \"name\": \"kpis\" },\n    { \"name\": \"players\" },\n    { \"name\": \"events_summary\", \"group_by\": [\"event_type\", \"language\", \"utm_source\"], \"metrics\": [{ \"fn\": \"count\", \"as\": \"events_count\" }, { \"fn\": \"count_distinct\", \"on\": \"player_id\", \"as\": \"unique_players\" }, { \"fn\": \"ratio\", \"num\": \"events_count\", \"den\": \"unique_players\", \"as\": \"events_per_player\" }, { \"fn\": \"avg\", \"on\": \"score\", \"as\": \"avg_score\" }] },\n    { \"name\": \"answers\", \"group_by\": [\"question_id\", \"question\", \"answer\"], \"metrics\": [{ \"fn\": \"count\", \"as\": \"answers_count\" }, { \"fn\": \"percentage\", \"partition\": \"question_id\", \"as\": \"percentage\" }] },\n    { \"name\": \"transactions\" },\n    { \"name\": \"configurazione_richiesta\" },\n    { \"name\": \"data_quality\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/versions/{{version_id}}/exports", "host": ["{{base_url}}"], "path": ["versions", "{{version_id}}", "exports"] }
          }
        },
        {
          "name": "Create export (heavy)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"format\": \"xlsx\",\n  \"sheets\": [\n    { \"name\": \"players\", \"columns\": [\"player_id\", \"email\", \"registered_at\", \"language\", \"utm_source\", \"company\", \"total_score\", \"levels_completed\", \"events_count\", \"reward\", \"status\", \"marketing_optin\", \"revenue\"] },\n    { \"name\": \"transactions\", \"columns\": [\"transaction_id\", \"player_id\", \"email\", \"type\", \"amount\", \"language\", \"utm_source\", \"occurred_at\"] },\n    { \"name\": \"events_summary\", \"group_by\": [\"event_type\", \"language\", \"utm_source\"], \"metrics\": [{ \"fn\": \"count\", \"as\": \"events_count\" }, { \"fn\": \"count_distinct\", \"on\": \"player_id\", \"as\": \"unique_players\" }, { \"fn\": \"ratio\", \"num\": \"events_count\", \"den\": \"unique_players\", \"as\": \"events_per_player\" }, { \"fn\": \"avg\", \"on\": \"score\", \"as\": \"avg_score\" }] },\n    { \"name\": \"kpis\" },\n    { \"name\": \"data_quality\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/versions/{{version_id}}/exports", "host": ["{{base_url}}"], "path": ["versions", "{{version_id}}", "exports"] },
            "description": "Export pesante senza filtri (tutte le entita' + colonne payload) per testare il job lungo su dati demo (~500k eventi). Usare un version_id popolato dal DemoSeeder."
          }
        },
        {
          "name": "Preview export",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"format\": \"xlsx\",\n  \"sheets\": [\n    { \"name\": \"players\", \"columns\": [\"player_id\", \"email\", \"total_score\"] }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/versions/{{version_id}}/exports/preview", "host": ["{{base_url}}"], "path": ["versions", "{{version_id}}", "exports", "preview"] }
          }
        },
        {
          "name": "Show export",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/exports/{{export_id}}", "host": ["{{base_url}}"], "path": ["exports", "{{export_id}}"] }
          }
        },
        {
          "name": "Download export",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/exports/{{export_id}}/download", "host": ["{{base_url}}"], "path": ["exports", "{{export_id}}", "download"] }
          }
        },
        {
          "name": "Delete export",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/exports/{{export_id}}", "host": ["{{base_url}}"], "path": ["exports", "{{export_id}}"] }
          }
        }
      ]
    }
  ]
}
