APP_KEY=base64:changeme
APP_ENV=local
APP_DEBUG=true

DB_DATABASE=export_engine
DB_USERNAME=export_engine
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Export queue workers (read by docker-compose)
# EXPORT_WORKER_CONCURRENCY = max export jobs processed in parallel (worker replicas)
EXPORT_WORKER_CONCURRENCY=2
QUEUE_SLEEP=3
QUEUE_TIMEOUT=360
QUEUE_MAX_JOBS=1000
